# -----------------------------------------------------------------
# St. Teresa Kanyange Academy - root rules
#
# Safe additions only. Existing HTML pages, CSS, JS, images and
# uploads continue to work exactly as before.
# -----------------------------------------------------------------

Options -Indexes

# Never serve backups, SQL dumps, logs, reports or environment files.
<FilesMatch "\.(sql|md|log|ini|bak|old|orig|zip|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve dotfiles (.gitignore, .env, .htaccess, etc.).
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve hidden repository/tool folders (.git, .github, .idea...).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.(git|github|vscode|idea|env)(/|$) - [F,L,NC]
</IfModule>

# Sensible security headers for every response.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# -----------------------------------------------------------------
# URL preservation (Stage 2)
#
# Every existing .html URL keeps working but is served by the new
# PHP shell for that page. The original .html files are still on
# disk and are never deleted.
# -----------------------------------------------------------------
<IfModule dir_module>
  DirectoryIndex index.php
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^index\.html$ index.php [L]
  RewriteRule ^about\.html$ about.php [L]
  RewriteRule ^academics\.html$ academics.php [L]
  RewriteRule ^admissions\.html$ admissions.php [L]
  RewriteRule ^contact\.html$ contact.php [L]

  RewriteRule ^admin/login\.html$ admin/login.php [L]
  RewriteRule ^admin/password\.html$ admin/password.php [L]
  RewriteRule ^admin/dashboard\.html$ admin/dashboard.php [L]

  RewriteRule ^headteacher/dashboard\.html$ headteacher/dashboard.php [L]
  RewriteRule ^chiefexaminer/dashboard\.html$ chiefexaminer/dashboard.php [L]
  RewriteRule ^kitchen/dashboard\.html$ kitchen/dashboard.php [L]
  RewriteRule ^store/dashboard\.html$ store/dashboard.php [L]
  RewriteRule ^uniforms/dashboard\.html$ uniforms/dashboard.php [L]
  RewriteRule ^secretary/dashboard\.html$ secretary/dashboard.php [L]
  RewriteRule ^teacher/dashboard\.html$ teacher/dashboard.php [L]
  RewriteRule ^student/dashboard\.html$ student/dashboard.php [L]
</IfModule>
